# LegaLite Frontend — Environment Variables
# NEVER commit .env to version control (already covered by .gitignore)

# ── Supabase (client-side, exposed to the browser) ────────────
# Found in: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://bcwmafblbsysasjvsdev.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_skpRBBP_z9fI1-YUQhrWng_RNF8ZA56

# ── LegaLite AI service (FastAPI on Railway) ──────────────────
# Used by /ai page for Q&A. POST /ask with { question, session_id? }.
NEXT_PUBLIC_LEGALITE_AI_URL=https://legalite-ai-production-ec4f.up.railway.app

# ── DEV ONLY — bypass dashboard auth gate ─────────────────────
# Lets you open /dashboard without logging in. REMOVE before deploying.
NEXT_PUBLIC_DEV_BYPASS_AUTH=false

# ── News feed (server-side, NewsData.io free tier) ────────────
# Get a free key at https://newsdata.io. Server-only, never exposed to the browser.
NEWSDATA_API_KEY=

# ── Sign-in routes (server-side, never exposed to the browser) ─
# Shared with the API (same value on both). At least 32 random characters:
#   openssl rand -base64 48
BFF_SHARED_SECRET=
# Optional: the API URL the app server calls for sign-in. Defaults to
# NEXT_PUBLIC_GRAPHQL_URL. Use the Railway private URL when both run there.
LEGALITE_API_GRAPHQL_URL=
